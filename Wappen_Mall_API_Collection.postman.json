    "/api/products/bulk": {
      "post": {
        "tags": [
          "Product API"
        ],
        "summary": "상품 대량 등록",
        "description": "CSV 파일과 이미지 ZIP 파일을 사용하여 상품을 대량으로 등록합니다.",
        "operationId": "bulkUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "csvFile"
                ],
                "type": "object",
                "properties": {
                  "csvFile": {
                    "type": "string",
                    "description": "상품 정보가 포함된 CSV 파일",
                    "format": "binary"
                  },
                  "zipFile": {
                    "type": "string",
                    "description": "상품 이미지들이 포함된 ZIP 파일 (선택사항)",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "잘못된 파일 형식",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 사용자",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "200": {
            "description": "대량 등록 성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer Authentication": []
          }
        ]
      }
