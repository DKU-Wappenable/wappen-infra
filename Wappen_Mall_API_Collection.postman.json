    "/api/products": {
      "get": {
        "tags": [
          "Product API"
        ],
        "summary": "상품 목록 조회",
        "description": "상품 목록을 페이지네이션과 검색, 정렬 기능과 함께 조회합니다.",
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "검색 키워드 (상품명 기준)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "정렬 기준",
            "required": false,
            "schema": {
              "type": "string",
              "default": "createdAt"
            },
            "example": "createdAt"
          },
          {
            "name": "direction",
            "in": "query",
            "description": "정렬 방향",
            "required": false,
            "schema": {
              "type": "string",
              "default": "desc"
            },
            "example": "desc"
          },
          {
            "name": "pageable",
            "in": "query",
            "description": "페이지네이션 정보",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
